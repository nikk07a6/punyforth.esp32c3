{
  "name": "punyforth-language",
  "displayName": "Punyforth",
  "description": "Syntax highlighting for Punyforth Forth source files",
  "version": "0.1.2",
  "publisher": "punyforth",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "forth",
        "aliases": [
          "Forth",
          "forth"
        ],
        "extensions": [
          ".fth",
          ".forth",
          ".4th"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "forth",
        "scopeName": "source.forth",
        "path": "./syntaxes/forth.tmLanguage.json"
      }
    ]
  }
}
